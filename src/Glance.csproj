<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Glance</RootNamespace>
    <AssemblyName>Glance</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <PackageCertificateKeyFile>Glance_TestKey_New.pfx</PackageCertificateKeyFile>
    <PackageCertificatePassword>glance123</PackageCertificatePassword>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**" />
    <None Include="Tests\**" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.4.0" />
    <PackageReference Include="PDFsharp" Version="6.1.1" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties (only apply during publish, not build) -->
  <PropertyGroup Condition="'$(PublishDir)' != ''">
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
  </PropertyGroup>

  <!-- Build Native (Rust) Library -->
  <!-- NOTE: Rust build is now manual. Disable by default to avoid errors. -->
  <!-- To rebuild Rust: cd native/glance-native then cargo build in release mode -->
  <!-- Then copy DLL to src/bin/Debug/net10.0-windows10.0.26100.0/win-x64/ -->
  <Target Name="BuildNativeLib" BeforeTargets="Build" Condition="'$(SkipNativeBuild)' == 'true'">
    <Message Text="🔨 Building native Rust library ($(Configuration))..." Importance="High" />
    <PropertyGroup>
      <BuildScriptPath Condition="'$(SolutionDir)' != ''">$(SolutionDir)build\build-native.ps1</BuildScriptPath>
      <BuildScriptPath Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)..\build\build-native.ps1</BuildScriptPath>
    </PropertyGroup>
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(BuildScriptPath)&quot; -Configuration $(Configuration) -Platforms x64" ContinueOnError="true" />
  </Target>

  <!-- Include Native DLLs in Output -->
  <ItemGroup>
    <!-- Copy from Rust build directory to C# output directory -->
    <Content Include="..\native\glance-native\target\release\glance_native.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>glance_native.dll</Link>
    </Content>
    <Content Include="pdfium.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>pdfium.dll</Link>
    </Content>
  </ItemGroup>

  <!-- Post-build: Ensure DLLs are in the exe directory -->
  <Target Name="CopyNativeDll" AfterTargets="Build">
    <Copy SourceFiles="..\native\glance-native\target\release\glance_native.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="pdfium.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Message Text="Copied native DLLs to $(OutputPath)" Importance="High" />
  </Target>

  <!-- Exclude testing assets from final build and packaging to pass WACK -->
  <Target Name="ExcludePdfSharpQuality" AfterTargets="Build;Publish;CopyFilesToOutputDirectory">
    <Delete Files="$(OutputPath)PdfSharp.Quality.dll" Condition="Exists('$(OutputPath)PdfSharp.Quality.dll')" />
    <Delete Files="$(PublishDir)PdfSharp.Quality.dll" Condition="Exists('$(PublishDir)PdfSharp.Quality.dll') and '$(PublishDir)' != ''" />
  </Target>

  <Target Name="ExcludePdfSharpQualityFromPayload" AfterTargets="GetPackagingOutputs">
    <ItemGroup>
      <PackagingOutputs Remove="@(PackagingOutputs)" Condition="$([System.String]::new('%(Identity)').Contains('PdfSharp.Quality'))" />
      <AppxPackagePayload Remove="@(AppxPackagePayload)" Condition="$([System.String]::new('%(Identity)').Contains('PdfSharp.Quality'))" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::new('%(Identity)').Contains('PdfSharp.Quality'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::new('%(Identity)').Contains('PdfSharp.Quality'))" />
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="$([System.String]::new('%(Identity)').Contains('PdfSharp.Quality'))" />
    </ItemGroup>
  </Target>

  <Target Name="PrintPackagingOutputs" AfterTargets="ExcludePdfSharpQualityFromPayload">
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\packaging_outputs.txt" Lines="@(PackagingOutputs->'%(Identity) = %(TargetPath)')" Overwrite="true" />
  </Target>
</Project>